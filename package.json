{
  "name": "dsh-cross-agent",
  "version": "0.2.9",
  "description": "局域网跨端 agent 会话：两台机器上的 DSH 互相发现、放行、下指令、传文件、按白名单调用具名工具。 · LAN peer sessions for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CONTEXT.md",
    "WINDOWS.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=4 test/*.test.js",
    "check": "node --check index.js && node --check client.js && node --test --test-concurrency=4 test/*.test.js",
    "e2e": "node scripts/e2e.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "fake-peer": "node scripts/fake-peer.mjs",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Diomchen/dsh-cross-agent.git"
  },
  "homepage": "https://github.com/Diomchen/dsh-cross-agent#readme",
  "bugs": {
    "url": "https://github.com/Diomchen/dsh-cross-agent/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "lan",
    "peer"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
